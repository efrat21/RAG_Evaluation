# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Demo Users (comma-separated user:password pairs)
DEMO_USERS=alice:password123,bob:password456,admin:adminpass

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=company_knowledge
EMBEDDING_DIM=768

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=knowledge-assistant
OTEL_ENVIRONMENT=development

# Application
APP_VERSION=1.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# Grafana
GRAFANA_PASSWORD=admin

# Data paths
RAW_DATA_PATH=/app/data/raw
GOLDEN_DATASET_PATH=/app/data/golden_dataset/golden.jsonl

# Guardrails
GUARDRAIL_MAX_QUERY_LENGTH=1000
GUARDRAIL_TOPIC_THRESHOLD=0.7
GUARDRAIL_RATE_LIMIT_RPM=60

# Evaluation
PROMETHEUS_PUSHGATEWAY_URL=http://prometheus:9091
